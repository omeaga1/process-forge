{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProcessForgeScaffoldManifest",
  "type": "object",
  "required": ["$schema", "version", "updatedAt", "project", "organization", "policy", "scaffolds"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "updatedAt": { "type": "string" },
    "project": { "type": "string" },
    "organization": { "type": "string" },
    "policy": {
      "type": "object",
      "required": ["zeroUntrackedTodo", "requireExplicitRemovalCondition", "blockOnExpiredMilestone"],
      "properties": {
        "zeroUntrackedTodo": { "type": "boolean" },
        "requireExplicitRemovalCondition": { "type": "boolean" },
        "blockOnExpiredMilestone": { "type": "boolean" }
      }
    },
    "scaffolds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component",
          "lines",
          "type",
          "rationale",
          "removalCondition",
          "responsibleAgent",
          "blockedMilestone",
          "registeredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCAF-[A-Z0-9]+-[0-9]{3,}$"
          },
          "component": { "type": "string" },
          "lines": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["MOCK_FALLBACK", "TRANSITIONAL_ADAPTER", "SYNTHETIC_FIXTURE", "TEMPORARY_STUB"]
          },
          "rationale": { "type": "string" },
          "removalCondition": { "type": "string" },
          "responsibleAgent": { "type": "string" },
          "blockedMilestone": { "type": "string" },
          "registeredAt": { "type": "string" }
        }
      }
    }
  }
}
