# Cloudflare Pages response headers.
#
# The Content-Security-Policy is what makes "your API key only goes to your AI
# provider" something the browser enforces rather than something we promise:
# connect-src lists every server the app may talk to, and the browser refuses
# the rest. It also means a script injected into the page could not send a key
# anywhere else. Images are limited for the same reason (an image URL can carry
# data out). If you add a service, it must be added here or the app cannot
# reach it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://process-forge-community-library.vprescenzi.workers.dev https://api.github.com https://accounts.google.com/gsi/ http://localhost:11434 http://127.0.0.1:11434; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
